        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "rollNo": { "type": "string" },
        "gradeClass": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "notes": { "type": "string" }
